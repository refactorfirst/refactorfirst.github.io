<!-- RefactorFirst report template — port of
     RefactorFirst/report/src/main/resources/templates/refactor-first-report.mustache,
     adapted for embedding into the SPA (#app) instead of a standalone document.
     Scripts/stylesheets live in the app shell (index.html) and js/report-view.js. -->
<style>
    .rf-report {
        max-width: 100vw;
        width: 100%;
    }

    .rf-report nav {
        justify-content: center;
        padding: 0 40px;
        margin: 0 auto;
    }

    .rf-report .rf-header {
        padding: 0 40px;
    }

    .fullscreen-svg {
        width: 100%;
        height: 100%;
    }

    .popup {
        position: fixed;
        display: none;
        width: 95%;
        height: 95%;
        background-color: var(--bg, #fff);
        border: 1px solid #ccc;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1000;
        padding: 20px;
        box-sizing: border-box;
    }

    .overlay {
        position: fixed;
        display: none;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 999;
    }

    .close-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        cursor: pointer;
        font-size: 20px;
        font-weight: bold;
        background: none;
        border: none;
        padding: 2px 6px;
        /* Keep the close control clickable above graph canvases injected
           into the popup by sigma/3d-force-graph. */
        z-index: 10;
    }

    .chart-container {
        width: 95%;
        margin: 20px auto;
    }

    /* HTML5 replacements for the obsolete presentational attributes the
       upstream template used (align/border): text alignment, centered
       blocks and the data-table chrome now come from these classes. */
    .rf-text-center {
        text-align: center;
    }

    .rf-text-left {
        text-align: left;
    }

    .rf-text-right {
        text-align: right;
    }

    .rf-data-table {
        border: 5px solid;
        border-collapse: collapse;
        margin: 0 auto;
        /* mvp.css gives every table overflow-x: auto, which would make the
           table itself the scroll container and prevent the sticky header
           from pinning to the viewport while the page scrolls. */
        overflow: visible;
    }

    .rf-data-table th,
    .rf-data-table td {
        border: 1px solid;
        padding: 2px 6px;
    }

    /* Enhanced tables: sticky headers pinned to the viewport while their
       table scrolls, plus sortable-header, toolbar, pagination and copy
       affordances (plan: implement-paginated-tables-with-sticky-headers). */
    .rf-data-table thead th {
        position: sticky;
        top: 0;
        z-index: 5;
        /* A solid, contrasting background keeps scrolled rows from showing
           through and keeps the header text readable (the base stylesheet
           colours table header text near-white); the inset shadow restores
           the bottom border that border-collapse drops from sticky cells. */
        background: #2a6f97;
        color: #fff;
        box-shadow: inset 0 -1px 0 #1f5273;
    }

    .rf-sort-btn {
        background: none;
        border: none;
        padding: 0;
        font: inherit;
        color: inherit;
        cursor: pointer;
    }

    .rf-sort-btn:hover,
    .rf-sort-btn:focus-visible {
        text-decoration: underline;
    }

    .rf-sort-btn:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
    }

    .rf-sort-indicator {
        display: inline-block;
        min-width: 1em;
        margin-left: 0.25rem;
    }

    .rf-table-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin: 0.5rem auto;
        max-width: 95%;
    }

    .rf-table-toolbar .rf-copy-hint {
        font-size: 0.85rem;
        margin: 0;
    }

    .rf-table-search label {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .rf-table-search input {
        padding: 0.3rem 0.5rem;
        min-width: 14rem;
    }

    .rf-table-search .rf-search-clear {
        padding: 0.2rem 0.55rem;
        cursor: pointer;
    }

    .rf-table-match {
        font-size: 0.9rem;
    }

    .rf-export-btn {
        padding: 0.3rem 0.75rem;
        border: 1px solid #2a6f97;
        border-radius: 6px;
        background: #2a6f97;
        color: #fff;
        cursor: pointer;
    }

    .rf-export-btn:focus-visible,
    .rf-page-btn:focus-visible {
        outline: 2px solid #1f5273;
        outline-offset: 2px;
    }

    .rf-table-pagination {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
        justify-content: center;
        margin: 0.75rem 0;
    }

    .rf-page-btn {
        padding: 0.35rem 0.75rem;
        /* Explicit colours on both states: the base stylesheet gives plain
           buttons near-white text, which would be invisible on a white
           background. */
        border: 1px solid #2a6f97;
        border-radius: 6px;
        background: #fff;
        color: #1f2937;
        cursor: pointer;
    }

    .rf-page-btn:hover:not([disabled]) {
        background: #e8f0f6;
    }

    .rf-page-btn[disabled] {
        background: #f3f4f6;
        border-color: #c6d2dc;
        color: #6b7280;
        cursor: default;
    }

    .rf-data-table td[data-rf-copy] {
        cursor: copy;
    }

    .rf-data-table td[data-rf-copy]:focus-visible {
        outline: 2px solid #2a6f97;
        outline-offset: -2px;
    }

    @media (max-width: 640px) {
        .rf-table-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .rf-table-search input {
            width: 100%;
            min-width: 0;
            box-sizing: border-box;
        }
    }
</style>

<div class="rf-report" lang="en">
    <div class="overlay" id="overlay" data-popup-close="true"></div>

    <!-- Header & Navigation -->
    <div class="rf-header">
        <h1 class="rf-text-center">
            <a href="https://github.com/refactorfirst/refactorfirst" target="_blank">RefactorFirst</a> Report for
            <a href="{{project.repoUrl}}" target="_blank">{{project.name}} {{project.version}}</a>
        </h1>

        <!-- GitHub Support Badges -->
        <div class="rf-text-center">
            <h2>Show RefactorFirst some &#10084;&#65039;</h2>
            <a class="github-button" href="https://github.com/refactorfirst/refactorfirst" data-icon="octicon-star"
               data-size="large" data-show-count="true" aria-label="Star refactorfirst/refactorfirst on GitHub">Star</a>
            <a class="github-button" href="https://github.com/refactorfirst/refactorfirst/fork"
               data-icon="octicon-repo-forked" data-size="large" data-show-count="true"
               aria-label="Fork refactorfirst/refactorfirst on GitHub">Fork</a>
            <a class="github-button" href="https://github.com/refactorfirst/refactorfirst/subscription"
               data-icon="octicon-eye" data-size="large" data-show-count="true"
               aria-label="Watch refactorfirst/refactorfirst on GitHub">Watch</a>
            <a class="github-button" href="https://github.com/refactorfirst/refactorfirst/issues"
               data-icon="octicon-issue-opened" data-size="large" data-show-count="false"
               aria-label="Issue refactorfirst/refactorfirst on GitHub">Issue</a>
            <a class="github-button" href="https://github.com/sponsors/jimbethancourt" data-icon="octicon-heart"
               data-size="large" aria-label="Sponsor @jimbethancourt on GitHub">Sponsor</a>
        </div>

        <nav aria-label="Report sections">
            <ul>
                <li><a href="#CLASSMAP">Classes</a>
                    <ul>
                        <li><a href="#CLASSMAP">Class Map</a></li>
                        {{#classRelationshipsToRemove.hasRelationships}}
                            <li><a href="#CLASSEDGES">Class Relationships To Remove</a></li>
                        {{/classRelationshipsToRemove.hasRelationships}}
                    </ul>
                </li>
                {{#packageMap.hasEdges}}
                    <li><a href="#PACKAGEMAP">Packages</a>
                        <ul>
                            <li><a href="#PACKAGEMAP">Package Map</a></li>
                            {{#packageRelationshipsToRemove.hasRelationships}}
                                <li><a href="#PACKAGEEDGES">Package Relationships To Remove</a></li>
                            {{/packageRelationshipsToRemove.hasRelationships}}
                        </ul>
                    </li>
                {{/packageMap.hasEdges}}
                {{#hasDisharmonies}}
                    <li><a href="#DISHARMONIES">Disharmonies</a>
                        <ul>
                            {{#disharmonies}}
                                <li><a href="#{{anchorId}}">{{title}}</a></li>
                            {{/disharmonies}}
                        </ul>
                    </li>
                {{/hasDisharmonies}}
                {{#classCycles.hasCycles}}
                    <li><a href="#CYCLES">Cycles</a>
                        <ul>
                            <li><a href="#CYCLES">Class Cycles</a></li>
                            {{#classCycles.largestCycle.hasCycleMap}}
                            <li><a href="#CYCLEMAP">Cycle Map</a></li>
                            {{/classCycles.largestCycle.hasCycleMap}}
                        </ul>
                    </li>
                {{/classCycles.hasCycles}}
            </ul>
        </nav>
    </div>

    {{#project.analysisFailed}}
        <div role="alert" class="rf-text-center">
            <strong>Analysis incomplete:</strong> RefactorFirst could not finish scanning this project.
            The absence of findings below does not mean the project is clean.
        </div>
    {{/project.analysisFailed}}

    <!-- Class Map Section -->
<h2 id="CLASSMAP" class="rf-text-center">Class Map</h2>
<button style="display: block; margin: 0 auto;" type="button"
        data-popup-3d data-popup="popup-classGraph" data-container="graph-container-classGraph" data-dot-var="classGraph_dot">Show classGraph
    3D Popup
</button>
<button style="display: block; margin: 0 auto;" type="button"
        data-popup-2d data-popup="popup-classGraph" data-container="graph-container-classGraph" data-dot-var="classGraph_dot">Show classGraph 2D
    Popup
</button>

    <div class="popup" id="popup-classGraph">
        <button type="button" class="close-btn" data-popup-close="true" aria-label="Close popup">&times;</button>
        <div id="graph-container-classGraph" style="width: 100%; height: 100%;"></div>
    </div>

    <div class="rf-text-center">
        Red lines represent relationships to remove.<br>
        Red nodes represent classes to remove.<br>
        Zoom in / out with your mouse wheel and click/move to drag the image.<br>
        Number of classes: {{classMap.classCount}} Number of relationships: {{classMap.relationshipCount}}<br>
    </div>

    {{#classMap.dotThresholdExceeded}}
        <div class="rf-text-center">SVG is too big to render quickly</div>
    {{/classMap.dotThresholdExceeded}}
    {{^classMap.dotThresholdExceeded}}
        <div id="classGraph" style="width: 95%; height: 70vh; margin: auto; border: thin solid black"></div>
    {{/classMap.dotThresholdExceeded}}

    <br>
    <hr>
    <br>
    <br>

    <!-- Class Relationships To Remove Table -->
    {{#classRelationshipsToRemove.hasRelationships}}
        <h2 id="CLASSEDGES" class="rf-text-center">Class Relationship Removal Priority</h2>
        <h3 class="rf-text-center">Refactor Starting with Priority 1</h3>
        <div class="rf-text-center">
            Current Class Cycle Count: {{classRelationshipsToRemove.cycleCount}}<br>
            Number of Class Relationships to Remove: {{classRelationshipsToRemove.relationshipsToRemoveCount}}<br>
            Classes with <strong>*</strong> should be broken apart<br>
            Removing class relationships below will eliminate class cycles
        </div>
        <div class="rf-text-center">
            {{#classRelationshipsToRemove.tableUi.enhanced}}
            <div class="rf-table-toolbar" data-rf-toolbar="class-relationships">
                {{#classRelationshipsToRemove.tableUi.searchable}}
                <div class="rf-table-search" data-rf-search-slot="class-relationships"></div>
                {{/classRelationshipsToRemove.tableUi.searchable}}
                <span class="rf-table-match" role="status" data-rf-match="class-relationships">{{classRelationshipsToRemove.tableUi.matchStatus}}</span>
                {{#classRelationshipsToRemove.tableUi.copyable}}
                <span class="rf-copy-hint">Click a cell (or press Enter on it) to copy its text.</span>
                {{/classRelationshipsToRemove.tableUi.copyable}}
                {{#classRelationshipsToRemove.tableUi.exportable}}
                <button type="button" class="rf-export-btn" data-rf-export="class-relationships"
                        aria-label="Export the class relationships table as CSV">Export CSV</button>
                {{/classRelationshipsToRemove.tableUi.exportable}}
            </div>
            {{/classRelationshipsToRemove.tableUi.enhanced}}
            <table class="rf-data-table" data-rf-table="class-relationships">
                <caption>Class relationships to remove, in priority order</caption>
                <thead>
                <tr>
                    <th scope="col"{{#classRelationshipsToRemove.tableUi.sortable}} aria-sort="{{classRelationshipsToRemove.tableUi.colSort.0}}"{{/classRelationshipsToRemove.tableUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="class-relationships" data-sort-key="renderedLabel">Class Relationship <span class="rf-sort-indicator" aria-hidden="true">{{classRelationshipsToRemove.tableUi.colIndicator.0}}</span></button></th>
                    <th scope="col"{{#classRelationshipsToRemove.tableUi.sortable}} aria-sort="{{classRelationshipsToRemove.tableUi.colSort.1}}"{{/classRelationshipsToRemove.tableUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="class-relationships" data-sort-key="priority">Priority <span class="rf-sort-indicator" aria-hidden="true">{{classRelationshipsToRemove.tableUi.colIndicator.1}}</span></button></th>
                    <th scope="col"{{#classRelationshipsToRemove.tableUi.sortable}} aria-sort="{{classRelationshipsToRemove.tableUi.colSort.2}}"{{/classRelationshipsToRemove.tableUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="class-relationships" data-sort-key="cycleCount">In Class<br>Cycles <span class="rf-sort-indicator" aria-hidden="true">{{classRelationshipsToRemove.tableUi.colIndicator.2}}</span></button></th>
                    <th scope="col"{{#classRelationshipsToRemove.tableUi.sortable}} aria-sort="{{classRelationshipsToRemove.tableUi.colSort.3}}"{{/classRelationshipsToRemove.tableUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="class-relationships" data-sort-key="effortRank">Relationship<br>Strength <span class="rf-sort-indicator" aria-hidden="true">{{classRelationshipsToRemove.tableUi.colIndicator.3}}</span></button></th>
                    <th scope="col"{{#classRelationshipsToRemove.tableUi.sortable}} aria-sort="{{classRelationshipsToRemove.tableUi.colSort.4}}"{{/classRelationshipsToRemove.tableUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="class-relationships" data-sort-key="alsoRemovesPackageRelationship">Also Removes Pkg<br>Cycle Relationship <span class="rf-sort-indicator" aria-hidden="true">{{classRelationshipsToRemove.tableUi.colIndicator.4}}</span></button></th>
                    <th scope="col"{{#classRelationshipsToRemove.tableUi.sortable}} aria-sort="{{classRelationshipsToRemove.tableUi.colSort.5}}"{{/classRelationshipsToRemove.tableUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="class-relationships" data-sort-key="packageCycleCount">In Package<br>Cycles <span class="rf-sort-indicator" aria-hidden="true">{{classRelationshipsToRemove.tableUi.colIndicator.5}}</span></button></th>
                </tr>
                </thead>
                <tbody>
                {{#classRelationshipsToRemove.relationships}}
                    <tr>
                        <td class="rf-text-left">{{renderedLabel}}</td>
                        <td class="rf-text-right">{{priority}}</td>
                        <td class="rf-text-right">{{cycleCount}}</td>
                        <td class="rf-text-right">{{effortRank}}</td>
                        <td class="rf-text-left">{{#alsoRemovesPackageRelationship}}
                            <strong>true</strong>{{/alsoRemovesPackageRelationship}}{{^alsoRemovesPackageRelationship}}
                            false{{/alsoRemovesPackageRelationship}}</td>
                        <td class="rf-text-right">{{packageCycleCount}}</td>
                    </tr>
                {{/classRelationshipsToRemove.relationships}}
                </tbody>
            </table>
            {{#classRelationshipsToRemove.tableUi.paginated}}
            <nav class="rf-table-pagination" data-rf-pagination="class-relationships" aria-label="Pages of the class relationships table">
                <button type="button" class="rf-page-btn" data-rf-page="class-relationships" data-page-dir="prev"{{#classRelationshipsToRemove.tableUi.isFirstPage}} disabled{{/classRelationshipsToRemove.tableUi.isFirstPage}}>Previous</button>
                <span class="rf-page-status">{{classRelationshipsToRemove.tableUi.pageStatus}}</span>
                <button type="button" class="rf-page-btn" data-rf-page="class-relationships" data-page-dir="next"{{#classRelationshipsToRemove.tableUi.isLastPage}} disabled{{/classRelationshipsToRemove.tableUi.isLastPage}}>Next</button>
            </nav>
            {{/classRelationshipsToRemove.tableUi.paginated}}
        </div>
    {{/classRelationshipsToRemove.hasRelationships}}

    <br>
    <hr>
    <br>
    <br>

    <!-- Package Map Section -->
    {{#packageMap.hasEdges}}
        <h2 id="PACKAGEMAP" class="rf-text-center">Package Map</h2>
        <button style="display: block; margin: 0 auto;" type="button"
                data-popup-3d data-popup="popup-packageGraph" data-container="graph-container-packageGraph" data-dot-var="packageGraph_dot">Show
            packageGraph
            3D Popup
        </button>
        <button style="display: block; margin: 0 auto;" type="button"
                data-popup-2d data-popup="popup-packageGraph" data-container="graph-container-packageGraph" data-dot-var="packageGraph_dot">Show
            packageGraph 2D
            Popup
        </button>

        <div class="popup" id="popup-packageGraph">
            <button type="button" class="close-btn" data-popup-close="true" aria-label="Close popup">&times;</button>
            <div id="graph-container-packageGraph" style="width: 100%; height: 100%;"></div>
        </div>

        <div class="rf-text-center">
            Red lines represent relationships to remove.<br>
            Red nodes represent packages to remove.<br>
            Zoom in / out with your mouse wheel and click/move to drag the image.<br>
            Number of packages: {{packageMap.classCount}} Number of relationships: {{packageMap.relationshipCount}}<br>
        </div>

        {{#packageMap.dotThresholdExceeded}}
            <div class="rf-text-center">SVG is too big to render quickly</div>
        {{/packageMap.dotThresholdExceeded}}
        {{^packageMap.dotThresholdExceeded}}
            <div id="packageGraph" style="width: 95%; height: 70vh; margin: auto; border: thin solid black"></div>
        {{/packageMap.dotThresholdExceeded}}
    {{/packageMap.hasEdges}}

    <br>
    <hr>
    <br>
    <br>

    <!-- Package Relationships To Remove Table -->
    {{#packageRelationshipsToRemove.hasRelationships}}
        <h2 id="PACKAGEEDGES" class="rf-text-center">Package Relationship Removal Priority</h2>
        <h3 class="rf-text-center">Refactor Starting with Priority 1</h3>
        <div class="rf-text-center">
            Current Package Cycle Count: {{packageRelationshipsToRemove.cycleCount}}<br>
            Number of Package Relationships to Remove: {{packageRelationshipsToRemove.relationshipsToRemoveCount}}<br>
            Packages and classes with <strong>*</strong> should be broken apart<br>
            Removing package relationships below will eliminate package cycles
        </div>
        <div class="rf-text-center">
            {{#packageRelationshipsToRemove.tableUi.enhanced}}
            <div class="rf-table-toolbar" data-rf-toolbar="package-relationships">
                {{#packageRelationshipsToRemove.tableUi.searchable}}
                <div class="rf-table-search" data-rf-search-slot="package-relationships"></div>
                {{/packageRelationshipsToRemove.tableUi.searchable}}
                <span class="rf-table-match" role="status" data-rf-match="package-relationships">{{packageRelationshipsToRemove.tableUi.matchStatus}}</span>
                {{#packageRelationshipsToRemove.tableUi.copyable}}
                <span class="rf-copy-hint">Click a cell (or press Enter on it) to copy its text.</span>
                {{/packageRelationshipsToRemove.tableUi.copyable}}
                {{#packageRelationshipsToRemove.tableUi.exportable}}
                <button type="button" class="rf-export-btn" data-rf-export="package-relationships"
                        aria-label="Export the package relationships table as CSV">Export CSV</button>
                {{/packageRelationshipsToRemove.tableUi.exportable}}
            </div>
            {{/packageRelationshipsToRemove.tableUi.enhanced}}
            <table class="rf-data-table" data-rf-table="package-relationships">
                <caption>Package relationships to remove, in priority order</caption>
                <thead>
                <tr>
                    <th scope="col"{{#packageRelationshipsToRemove.tableUi.sortable}} aria-sort="{{packageRelationshipsToRemove.tableUi.colSort.0}}"{{/packageRelationshipsToRemove.tableUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="package-relationships" data-sort-key="renderedLabel">Package Relationship <span class="rf-sort-indicator" aria-hidden="true">{{packageRelationshipsToRemove.tableUi.colIndicator.0}}</span></button></th>
                    <th scope="col"{{#packageRelationshipsToRemove.tableUi.sortable}} aria-sort="{{packageRelationshipsToRemove.tableUi.colSort.1}}"{{/packageRelationshipsToRemove.tableUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="package-relationships" data-sort-key="priority">Priority <span class="rf-sort-indicator" aria-hidden="true">{{packageRelationshipsToRemove.tableUi.colIndicator.1}}</span></button></th>
                    <th scope="col"{{#packageRelationshipsToRemove.tableUi.sortable}} aria-sort="{{packageRelationshipsToRemove.tableUi.colSort.2}}"{{/packageRelationshipsToRemove.tableUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="package-relationships" data-sort-key="cycleCount">In Pkg<br>Cycles <span class="rf-sort-indicator" aria-hidden="true">{{packageRelationshipsToRemove.tableUi.colIndicator.2}}</span></button></th>
                    <th scope="col"{{#packageRelationshipsToRemove.tableUi.sortable}} aria-sort="{{packageRelationshipsToRemove.tableUi.colSort.3}}"{{/packageRelationshipsToRemove.tableUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="package-relationships" data-sort-key="effortRank">Relationship<br>Strength <span class="rf-sort-indicator" aria-hidden="true">{{packageRelationshipsToRemove.tableUi.colIndicator.3}}</span></button></th>
                    <th scope="col"{{#packageRelationshipsToRemove.tableUi.sortable}} aria-sort="{{packageRelationshipsToRemove.tableUi.colSort.4}}"{{/packageRelationshipsToRemove.tableUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="package-relationships" data-sort-key="classRelationshipsToBreakPackage">Class Relationships to Remove<br>To Break Package Relationship <span class="rf-sort-indicator" aria-hidden="true">{{packageRelationshipsToRemove.tableUi.colIndicator.4}}</span></button></th>
                </tr>
                </thead>
                <tbody>
                {{#packageRelationshipsToRemove.relationships}}
                    <tr>
                        <td class="rf-text-left">{{{renderedLabel}}}</td>
                        <td class="rf-text-right">{{priority}}</td>
                        <td class="rf-text-right">{{cycleCount}}</td>
                        <td class="rf-text-right">{{effortRank}}</td>
                        <td class="rf-text-left">{{#classRelationshipsToBreakPackage}}
                            {{{.}}}<br>{{/classRelationshipsToBreakPackage}}</td>
                    </tr>
                {{/packageRelationshipsToRemove.relationships}}
                </tbody>
            </table>
            {{#packageRelationshipsToRemove.tableUi.paginated}}
            <nav class="rf-table-pagination" data-rf-pagination="package-relationships" aria-label="Pages of the package relationships table">
                <button type="button" class="rf-page-btn" data-rf-page="package-relationships" data-page-dir="prev"{{#packageRelationshipsToRemove.tableUi.isFirstPage}} disabled{{/packageRelationshipsToRemove.tableUi.isFirstPage}}>Previous</button>
                <span class="rf-page-status">{{packageRelationshipsToRemove.tableUi.pageStatus}}</span>
                <button type="button" class="rf-page-btn" data-rf-page="package-relationships" data-page-dir="next"{{#packageRelationshipsToRemove.tableUi.isLastPage}} disabled{{/packageRelationshipsToRemove.tableUi.isLastPage}}>Next</button>
            </nav>
            {{/packageRelationshipsToRemove.tableUi.paginated}}
        </div>
    {{/packageRelationshipsToRemove.hasRelationships}}

    <!-- Disharmonies Sections with Chart.js Canvas -->
    {{#hasDisharmonies}}
        <br>
        <hr>
        <h2 id="DISHARMONIES" class="rf-text-center">Code Disharmonies</h2>
    {{/hasDisharmonies}}
    {{#disharmonies}}
        <br>
        <hr>
        <br>
        <br>
        <h3 id="{{anchorId}}" class="rf-text-center">{{title}}</h3>
        <div class="rf-text-center">
            <table class="rf-data-table">
                <caption>Problem and recommended solution for {{title}}</caption>
                <tbody>
                <tr>
                    <th scope="row">Problem:</th>
                    <td>{{problem}}</td>
                </tr>
                <tr>
                    <th scope="row">Solution:</th>
                    <td>{{{solution}}}</td>
                </tr>
                </tbody>
            </table>
        </div>

        <!-- Chart.js Canvas -->
        <div class="chart-container rf-text-center">
            <div style="position: relative; height: 500px; width: 100%; margin: 0 auto;">
                <canvas id="chart_{{anchorId}}" role="img"
                        aria-label="Bubble chart ranking {{title}} findings by priority and effort">Bubble chart visualizing the {{title}} findings: one bubble per class, ranked by priority and estimated effort.</canvas>
            </div>
        </div>

        <br>

        <h4 class="rf-text-center">{{title}} by the numbers: (Refactor Starting with Priority 1)</h4>
        <div class="rf-text-center">
            {{#ui.enhanced}}
            <div class="rf-table-toolbar" data-rf-toolbar="{{ui.tableId}}">
                {{#ui.searchable}}
                <div class="rf-table-search" data-rf-search-slot="{{ui.tableId}}"></div>
                {{/ui.searchable}}
                <span class="rf-table-match" role="status" data-rf-match="{{ui.tableId}}">{{ui.matchStatus}}</span>
                {{#ui.copyable}}
                <span class="rf-copy-hint">Click a cell (or press Enter on it) to copy its text.</span>
                {{/ui.copyable}}
                {{#ui.exportable}}
                <button type="button" class="rf-export-btn" data-rf-export="{{ui.tableId}}"
                        aria-label="Export the {{title}} findings table as CSV">Export CSV</button>
                {{/ui.exportable}}
            </div>
            {{/ui.enhanced}}
            <table class="rf-data-table" data-rf-table="{{ui.tableId}}">
                <caption>{{title}} findings, in priority order</caption>
                <thead>
                <tr>
                    {{#table.headerObjs}}
                        <th scope="col" aria-sort="{{sortState}}"><button type="button" class="rf-sort-btn" data-rf-sort="{{tableId}}" data-sort-key="{{key}}">{{label}} <span class="rf-sort-indicator" aria-hidden="true">{{indicator}}</span></button></th>
                    {{/table.headerObjs}}
                    {{^table.headerObjs}}
                        {{#table.headers}}
                            <th scope="col">{{.}}</th>
                        {{/table.headers}}
                    {{/table.headerObjs}}
                </tr>
                </thead>
                <tbody>
                {{#table.rows}}
                    <tr>
                        {{#cells}}
                            <td class="rf-text-{{align}}">{{{content}}}</td>
                        {{/cells}}
                    </tr>
                {{/table.rows}}
                </tbody>
            </table>
            {{#ui.paginated}}
            <nav class="rf-table-pagination" data-rf-pagination="{{ui.tableId}}" aria-label="Pages of the {{title}} findings table">
                <button type="button" class="rf-page-btn" data-rf-page="{{ui.tableId}}" data-page-dir="prev"{{#ui.isFirstPage}} disabled{{/ui.isFirstPage}}>Previous</button>
                <span class="rf-page-status">{{ui.pageStatus}}</span>
                <button type="button" class="rf-page-btn" data-rf-page="{{ui.tableId}}" data-page-dir="next"{{#ui.isLastPage}} disabled{{/ui.isLastPage}}>Next</button>
            </nav>
            {{/ui.paginated}}
        </div>
    {{/disharmonies}}

    <br>
    <hr>
    <br>
    <br>

    <!-- Cycles Summary Table & Cycle Map -->
    {{#classCycles.hasCycles}}
        <h2 id="CYCLES" class="rf-text-center">Class Cycles</h2>
        <h3 class="rf-text-center">Class Cycles by the numbers:</h3>
        <div class="rf-text-center">
            {{#classCycles.summaryUi.enhanced}}
            <div class="rf-table-toolbar" data-rf-toolbar="class-cycles-summary">
                {{#classCycles.summaryUi.searchable}}
                <div class="rf-table-search" data-rf-search-slot="class-cycles-summary"></div>
                {{/classCycles.summaryUi.searchable}}
                <span class="rf-table-match" role="status" data-rf-match="class-cycles-summary">{{classCycles.summaryUi.matchStatus}}</span>
                {{#classCycles.summaryUi.copyable}}
                <span class="rf-copy-hint">Click a cell (or press Enter on it) to copy its text.</span>
                {{/classCycles.summaryUi.copyable}}
                {{#classCycles.summaryUi.exportable}}
                <button type="button" class="rf-export-btn" data-rf-export="class-cycles-summary"
                        aria-label="Export the class cycles summary table as CSV">Export CSV</button>
                {{/classCycles.summaryUi.exportable}}
            </div>
            {{/classCycles.summaryUi.enhanced}}
            <table class="rf-data-table" data-rf-table="class-cycles-summary">
                <caption>Class cycles summary</caption>
                <thead>
                <tr>
                    <th scope="col"{{#classCycles.summaryUi.sortable}} aria-sort="{{classCycles.summaryUi.colSort.0}}"{{/classCycles.summaryUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="class-cycles-summary" data-sort-key="cycleName">Cycle Name <span class="rf-sort-indicator" aria-hidden="true">{{classCycles.summaryUi.colIndicator.0}}</span></button></th>
                    <th scope="col"{{#classCycles.summaryUi.sortable}} aria-sort="{{classCycles.summaryUi.colSort.1}}"{{/classCycles.summaryUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="class-cycles-summary" data-sort-key="priority">Priority <span class="rf-sort-indicator" aria-hidden="true">{{classCycles.summaryUi.colIndicator.1}}</span></button></th>
                    <th scope="col"{{#classCycles.summaryUi.sortable}} aria-sort="{{classCycles.summaryUi.colSort.2}}"{{/classCycles.summaryUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="class-cycles-summary" data-sort-key="classCount">Class Count <span class="rf-sort-indicator" aria-hidden="true">{{classCycles.summaryUi.colIndicator.2}}</span></button></th>
                    <th scope="col"{{#classCycles.summaryUi.sortable}} aria-sort="{{classCycles.summaryUi.colSort.3}}"{{/classCycles.summaryUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="class-cycles-summary" data-sort-key="relationshipCount">Relationship Count <span class="rf-sort-indicator" aria-hidden="true">{{classCycles.summaryUi.colIndicator.3}}</span></button></th>
                </tr>
                </thead>
                <tbody>
                {{#classCycles.summary}}
                    <tr>
                        <td class="rf-text-left">{{cycleName}}</td>
                        <td class="rf-text-right">{{priority}}</td>
                        <td class="rf-text-right">{{classCount}}</td>
                        <td class="rf-text-right">{{relationshipCount}}</td>
                    </tr>
                {{/classCycles.summary}}
                </tbody>
            </table>
            {{#classCycles.summaryUi.paginated}}
            <nav class="rf-table-pagination" data-rf-pagination="class-cycles-summary" aria-label="Pages of the class cycles summary table">
                <button type="button" class="rf-page-btn" data-rf-page="class-cycles-summary" data-page-dir="prev"{{#classCycles.summaryUi.isFirstPage}} disabled{{/classCycles.summaryUi.isFirstPage}}>Previous</button>
                <span class="rf-page-status">{{classCycles.summaryUi.pageStatus}}</span>
                <button type="button" class="rf-page-btn" data-rf-page="class-cycles-summary" data-page-dir="next"{{#classCycles.summaryUi.isLastPage}} disabled{{/classCycles.summaryUi.isLastPage}}>Next</button>
            </nav>
            {{/classCycles.summaryUi.paginated}}
        </div>

        {{#classCycles.largestCycle.hasCycleMap}}
            <h3 id="CYCLEMAP" class="rf-text-center">Largest Class Cycle : {{classCycles.largestCycle.cycleName}}</h3>
            <h4 class="rf-text-center">Limiting number of cycles displayed to 1 to keep page load time fast</h4>

            <button style="display: block; margin: 0 auto;" type="button"
                    data-popup-3d data-popup="popup-{{classCycles.largestCycle.cycleIdentifier}}" data-container="graph-container-{{classCycles.largestCycle.cycleIdentifier}}" data-dot-var="{{classCycles.largestCycle.cycleIdentifier}}_dot">
                Show {{classCycles.largestCycle.cycleName}} 3D Popup
            </button>
            <button style="display: block; margin: 0 auto;" type="button"
                    data-popup-2d data-popup="popup-{{classCycles.largestCycle.cycleIdentifier}}" data-container="graph-container-{{classCycles.largestCycle.cycleIdentifier}}" data-dot-var="{{classCycles.largestCycle.cycleIdentifier}}_dot">
                Show {{classCycles.largestCycle.cycleName}} 2D Popup
            </button>

            <div class="popup" id="popup-{{classCycles.largestCycle.cycleIdentifier}}">
                <button type="button" class="close-btn" data-popup-close="true" aria-label="Close popup">&times;</button>
                <div id="graph-container-{{classCycles.largestCycle.cycleIdentifier}}"
                     style="width: 100%; height: 100%;"></div>
            </div>

            <div id="{{classCycles.largestCycle.cycleIdentifier}}"
                 style="width: 95%; height: 70vh; margin: auto; border: thin solid black"></div>

            <!-- Cycle Breakdown Table -->
            <div class="rf-text-center">
                {{#classCycles.largestCycle.breakdownUi.enhanced}}
                <div class="rf-table-toolbar" data-rf-toolbar="largest-cycle-breakdown">
                    {{#classCycles.largestCycle.breakdownUi.searchable}}
                    <div class="rf-table-search" data-rf-search-slot="largest-cycle-breakdown"></div>
                    {{/classCycles.largestCycle.breakdownUi.searchable}}
                    <span class="rf-table-match" role="status" data-rf-match="largest-cycle-breakdown">{{classCycles.largestCycle.breakdownUi.matchStatus}}</span>
                    {{#classCycles.largestCycle.breakdownUi.copyable}}
                    <span class="rf-copy-hint">Click a cell (or press Enter on it) to copy its text.</span>
                    {{/classCycles.largestCycle.breakdownUi.copyable}}
                    {{#classCycles.largestCycle.breakdownUi.exportable}}
                    <button type="button" class="rf-export-btn" data-rf-export="largest-cycle-breakdown"
                            aria-label="Export the largest cycle breakdown table as CSV">Export CSV</button>
                    {{/classCycles.largestCycle.breakdownUi.exportable}}
                </div>
                {{/classCycles.largestCycle.breakdownUi.enhanced}}
                <table class="rf-data-table" data-rf-table="largest-cycle-breakdown">
                    <caption>Classes and relationships in the largest cycle</caption>
                    <thead>
                    <tr>
                        <th scope="col"{{#classCycles.largestCycle.breakdownUi.sortable}} aria-sort="{{classCycles.largestCycle.breakdownUi.colSort.0}}"{{/classCycles.largestCycle.breakdownUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="largest-cycle-breakdown" data-sort-key="className">Classes <span class="rf-sort-indicator" aria-hidden="true">{{classCycles.largestCycle.breakdownUi.colIndicator.0}}</span></button></th>
                        <th scope="col"{{#classCycles.largestCycle.breakdownUi.sortable}} aria-sort="{{classCycles.largestCycle.breakdownUi.colSort.1}}"{{/classCycles.largestCycle.breakdownUi.sortable}}><button type="button" class="rf-sort-btn" data-rf-sort="largest-cycle-breakdown" data-sort-key="edgesHtml">Relationships <span class="rf-sort-indicator" aria-hidden="true">{{classCycles.largestCycle.breakdownUi.colIndicator.1}}</span></button></th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#classCycles.largestCycle.breakdown}}
                        <tr>
                            <td class="rf-text-left">{{{className}}}</td>
                            <td class="rf-text-left">{{{edgesHtml}}}</td>
                        </tr>
                    {{/classCycles.largestCycle.breakdown}}
                    </tbody>
                </table>
                {{#classCycles.largestCycle.breakdownUi.paginated}}
                <nav class="rf-table-pagination" data-rf-pagination="largest-cycle-breakdown" aria-label="Pages of the largest cycle breakdown table">
                    <button type="button" class="rf-page-btn" data-rf-page="largest-cycle-breakdown" data-page-dir="prev"{{#classCycles.largestCycle.breakdownUi.isFirstPage}} disabled{{/classCycles.largestCycle.breakdownUi.isFirstPage}}>Previous</button>
                    <span class="rf-page-status">{{classCycles.largestCycle.breakdownUi.pageStatus}}</span>
                    <button type="button" class="rf-page-btn" data-rf-page="largest-cycle-breakdown" data-page-dir="next"{{#classCycles.largestCycle.breakdownUi.isLastPage}} disabled{{/classCycles.largestCycle.breakdownUi.isLastPage}}>Next</button>
                </nav>
                {{/classCycles.largestCycle.breakdownUi.paginated}}
            </div>
        {{/classCycles.largestCycle.hasCycleMap}}
    {{/classCycles.hasCycles}}

    <footer>
        <div class="clear">
            <hr>
        </div>
        <span id="publishDate">Last Published: {{project.scanTimestamp}}</span>
    </footer>
</div>
