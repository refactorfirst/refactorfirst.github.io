{
  "name": "refactorfirst-page",
  "version": "1.0.0",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@sentry/browser": "^7.80.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^23.0.0"
  },
  "description": "RefactorFirst GitHub Pages Application",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "node scripts/sync-repositories.mjs && next dev",
    "build": "node scripts/sync-repositories.mjs && next build && node scripts/fix-csp-hashes.mjs",
    "test": "bun test tests/unit tests/integration",
    "test:watch": "bun test --watch tests/unit tests/integration",
    "test:coverage": "bun test --coverage tests/unit tests/integration",
    "test:e2e": "npx playwright test",
    "test:e2e:basepath": "npx playwright test --config playwright.basepath.config.js",
    "test:e2e:ui": "npx playwright test --ui",
    "lint": "eslint lib/**/*.js app/**/*.jsx components/**/*.jsx tests/**/*.js tests/**/*.jsx",
    "lint:fix": "eslint lib/**/*.js app/**/*.jsx components/**/*.jsx tests/**/*.js tests/**/*.jsx --fix"
  },
  "type": "module",
  "dependencies": {
    "dompurify": "^3.4.15",
    "mustache": "^4.2.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
